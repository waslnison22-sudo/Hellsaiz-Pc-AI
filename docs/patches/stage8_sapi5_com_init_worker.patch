# Патч этапа 8: COM-инициализация и телеметрия в SapiVoiceListWorker.
# Телеметрия run 21: лог stage7 «assistant voice list refresh dispatched»
# появился, comtypes-импорт прошёл в worker-потоке (кэш SpeechLib уже есть
# в бандле 0.1.6, генерации нет); затем процесс замолчал: нет ни «voice
# library tab built», ни «timers scheduled». Причина: SapiVoiceListWorker.run()
# не инициализирует COM — pyttsx3.init("sapi5") создаёт SAPI COM-объект в
# QThread без CoInitialize; на headless-раннере это зависает, удерживая GIL,
# и главный поток тоже замирает. Фикс: worker явно вызывает
# pythoncom.CoInitialize() (guard на ImportError для Linux/CI) и
# CoUninitialize() в finally; добавлены логи до и после опроса голосов,
# чтобы следующий прогон показал точную точку, если hang всё же повторится.
--- a/src/hellsaiz_pc_ai/app/ui_workers.py
+++ b/src/hellsaiz_pc_ai/app/ui_workers.py
@@ -233,7 +233,23 @@
-        try:
-            from hellsaiz_pc_ai.speech.sapi5 import Sapi5Synthesizer
-
-            voices = Sapi5Synthesizer("", self.rate, self.volume).list_voices()
-            self.completed.emit(voices)
-        except Exception as exc:
-            self.failed.emit(str(exc))
+        com_module = None
+        try:
+            import pythoncom as com_module
+        except ImportError:
+            com_module = None
+        try:
+            if com_module is not None:
+                com_module.CoInitialize()
+            logging.info(
+                "SapiVoiceListWorker: run() entered; thread COM initialized."
+            )
+            from hellsaiz_pc_ai.speech.sapi5 import Sapi5Synthesizer
+            voices = Sapi5Synthesizer("", self.rate, self.volume).list_voices()
+            logging.info(
+                "SapiVoiceListWorker: enumerated %d SAPI5 voices.", len(voices)
+            )
+            self.completed.emit(voices)
+        except Exception as exc:
+            logging.info("SapiVoiceListWorker: voice enumeration failed: %s", exc)
+            self.failed.emit(str(exc))
+        finally:
+            if com_module is not None:
+                com_module.CoUninitialize()
